appname                    = portguard
version                    = 1.0.0
display_name               = 端口态势感知
desc                       = 一屏看清 NAS 的端口占用与暴露面：自动识别端口用途、穿透容器归因到具体应用、识别「开着没人用」的闲置端口与泄漏端口、检测端口冲突，并按暴露面给出风险评级。<br/><br/><strong>核心能力：</strong><br/>• 端口语义识别：内置 200+ 服务指纹，看到 3306 就知道是 MySQL<br/>• 四层归因：端口 → 进程 → 容器 / systemd → 飞牛应用<br/>• 使用度判定：活跃 / 低频 / 闲置 / 僵尸 / 幽灵，附连接数与流量证据<br/>• 冲突检测：双协议同号、端口共享、映射抢占、声明不符、归属异常<br/>• 风险评级：区分「仅本机」「局域网」「公网 IPv6 可直连」<br/>• 全只读采集，不修改任何系统配置、不启停任何服务
platform                   = all
source                     = thirdparty
maintainer                 = HUIdada1
maintainer_url             = https://github.com/HUIdada1/fnOS_port_monitoring
distributor                = HUIdada1
distributor_url            = https://github.com/HUIdada1/fnOS_port_monitoring
os_min_version             = 1.1.8
desktop_uidir              = ui
desktop_applaunchname      = portguard.Application
service_port               = 18110
checkport                  = true
ctl_stop                   = true
disable_authorization_path = true
changelog                  = 首个公开版本：端口矩阵、七态判定、四层归因、冲突检测、风险评分、报告导出
