#!/bin/bash
# 安装前预检：Python 运行时、标准库、端口占用
set -u
export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/usr/sbin:/bin:/sbin

PORT="${TRIM_SERVICE_PORT:-18110}"
PY="$(command -v python3 2>/dev/null || echo /usr/bin/python3)"
ERR="${TRIM_TEMP_LOGFILE:-/dev/null}"

if [ ! -x "${PY}" ]; then
    echo "未找到 python3。PortGuard 依赖系统自带的 Python 3，无法继续安装。" > "${ERR}"
    exit 1
fi

MSG="$("${PY}" - "${PORT}" <<'PYEOF'
import sys

port = int(sys.argv[1])

missing = []
for name in ("json", "socket", "sqlite3", "subprocess", "http.server", "hmac", "hashlib"):
    try:
        __import__(name)
    except Exception:
        missing.append(name)
if missing:
    print("缺少 Python 标准库：%s。请确认系统 Python 完整后再安装。" % ", ".join(missing))
    sys.exit(1)

busy = False
for path in ("/proc/net/tcp", "/proc/net/tcp6"):
    try:
        with open(path) as fh:
            next(fh, None)
            for line in fh:
                fields = line.split()
                if len(fields) > 3 and fields[3] == "0A":
                    if int(fields[1].rsplit(":", 1)[1], 16) == port:
                        busy = True
                        break
    except (OSError, ValueError, IndexError):
        continue
    if busy:
        break

if busy:
    print("端口 %d 已被占用，请先释放该端口再安装 PortGuard。" % port)
    sys.exit(1)

print("ok")
PYEOF
)"
if [ $? -ne 0 ]; then
    echo "${MSG}" > "${ERR}"
    exit 1
fi

if [ -d /var/apps/portview ]; then
    echo "[info] 检测到已安装 portview（同类应用），两者可以共存；PortGuard 使用 ${PORT} 端口。"
fi

exit 0
